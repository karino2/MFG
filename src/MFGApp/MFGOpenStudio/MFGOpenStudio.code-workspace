				"name": "launch MFGOpenStudio (windows VS)",
				"type": "cppvsdbg",
				"request": "launch",
				"program": "${workspaceFolder:MFGOpenStudio}/build/Debug/MFGOpenStudio.exe",
				"sourceFileMap": {
					"C:/Users/qt/work/qt": "C:/Qt/6.8.0/Src"
				},
