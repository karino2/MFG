	            "terminal":"console",
				"internalConsoleOptions": "openOnSessionStart",
				"preLaunchTask": "Build MFGOpenStudio with cmake"
			},
			{
				"name": "launch MFGOpenStudio(cppdbg)",
				"type":"cppdbg",
				"logging": {"moduleLoad": false},
