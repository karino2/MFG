	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Build MFGOpenStudio with cmake",
				"command": "cmake",
				"type": "shell",
				"args": [
					"--build",
					"./build",
					"--config",
					"Debug",
					"--target",
					"MFGOpenStudio",
				],
				"windows": {
					"args": [
						"--build",
						"./build",
						"--config",
						"Debug",
						"--target",
						"MFGOpenStudio",
						"--",
						"/p:UseMultiToolTask=true"
					],	
				},
				"options": {
					"cwd": "${workspaceFolder:MFGOpenStudio}"
				},
				"problemMatcher": [
					"$tsc"
				],
				"presentation": {
					"reveal": "always"
				},
				"group": "build"
			}
		]
